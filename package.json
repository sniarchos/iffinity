{
    "name": "iffinity",
    "repository": {
        "type": "git",
        "url": "https://github.com/sniarchos/iffinity.git"
    },
    "version": "1.0.0",
    "description": "A minimal IF engine with iffinite capabilities",
    "main": "dist/backend/cli.js",
    "types": "dist/backend/cli.d.ts",
    "engines": {
        "node": ">=18"
    },
    "files": [
        "dist/",
        "examples/"
    ],
    "scripts": {
        "build": "tsc && webpack --config webpack.config.js",
        "test": "tsc -p tsconfig.test.json && cd .test-build && node --test",
        "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
        "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\""
    },
    "bin": {
        "ifc": "dist/backend/cli.js"
    },
    "keywords": [],
    "author": "Sotiris Niarchos",
    "license": "MIT",
    "devDependencies": {
        "@types/ejs": "^3.1.3",
        "@types/jquery": "^3.5.20",
        "@types/node": "^20.8.2",
        "@types/yargs": "^17.0.26",
        "ejs": "^3.1.9",
        "expose-loader": "^4.1.0",
        "jquery": "^3.7.1",
        "prettier": "3.9.6",
        "typescript": "^5.2.2",
        "webpack": "^5.88.2",
        "webpack-cli": "^5.1.4"
    },
    "dependencies": {
        "ansis": "^1.5.6",
        "cheerio": "^1.2.0",
        "domhandler": "^5.0.3",
        "flexible-tree-printer": "^1.0.2",
        "html-entities": "^2.4.0",
        "html-validate": "^8.7.0",
        "yargs": "^17.7.2"
    }
}
